pipeline {
  agent {
    docker {
      image 'maven:3.9.6-eclipse-temurin-17'
      // run as root so we can apt-get install docker CLI if missing, and mount host docker socket
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }

  environment {
    // Sonar and other constants
    SONAR_URL = "http://65.1.136.198:9000/"
    DOCKER_REPO = "abhishekf5"
    APP_PATH = "java-maven-sonar-argocd-helm-k8s/spring-boot-app"
    DEPLOY_MANIFEST = "java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml"
    GIT_REPO_NAME = "Jenkins-Zero-To-Hero"
    GIT_USER_NAME = "ShreyasGrandhe"
    GIT_USER_EMAIL = "shreyas.xyz@gmail.com"
  }

  stages {
    stage('Checkout') {
      steps {
        echo "Checking out repository..."
        // uncomment the line below if you want to let the pipeline perform checkout
        // checkout scm
        sh 'echo "passed"; whoami; pwd; ls -la'
      }
    }

    stage('Verify env') {
      steps {
        sh '''
          echo "== Verify environment =="
          java -version
          mvn -version
          echo "== Check docker CLI =="
          if ! command -v docker >/dev/null 2>&1; then
            echo "docker CLI not found — installing docker.io (will use host docker daemon via socket)..."
            apt-get update -y && apt-get install -y docker.io
          else
            echo "docker CLI present: $(docker --version)"
          fi
          echo "== End verify =="
        '''
      }
    }

    stage('Build and Test') {
      steps {
        sh '''
          echo "== Build and package =="
          cd ${APP_PATH}
          mvn -B -U clean package
          echo "== Build finished =="
        '''
      }
    }

    stage('Static Code Analysis') {
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh '''
            echo "== Sonar analysis =="
            cd ${APP_PATH}
            mvn -B -DskipTests=true sonar:sonar -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}
            echo "== Sonar finished =="
          '''
        }
      }
    }

    stage('Build and Push Docker Image') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'docker-cred', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
          script {
            // Compose image tag
            env.DOCKER_IMAGE = "${DOCKER_REPO}/ultimate-cicd:${BUILD_NUMBER}"

            sh '''
              echo "== Docker build & push =="
              cd ${APP_PATH}
              docker build -t ${DOCKER_IMAGE} .
              echo "Logging in to Docker registry..."
              echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
              docker push ${DOCKER_IMAGE}
              docker logout
              echo "== Docker push finished =="
            '''
          }
        }
      }
    }

    stage('Update Deployment File') {
      steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
          sh '''
            echo "== Update deployment manifest =="
            git config user.email "${GIT_USER_EMAIL}"
            git config user.name "${GIT_USER_NAME}"
            BUILD_NUMBER=${BUILD_NUMBER}
            # Replace placeholder tag in deployment.yml with current build number
            sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" ${DEPLOY_MANIFEST} || true
            git add ${DEPLOY_MANIFEST} || true
            git commit -m "Update deployment image to version ${BUILD_NUMBER}" || echo "No changes to commit"
            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
            echo "== Deployment manifest update complete =="
          '''
        }
      }
    }
  }

  post {
    success {
      echo "Pipeline finished SUCCESS"
    }
    failure {
      echo "Pipeline FAILED — check console output"
    }
    always {
      // optional cleanup
      sh 'echo "Cleaning workspace..."; ls -la'
    }
  }
}
